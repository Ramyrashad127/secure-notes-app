# ============================================================
# Secure Notes — runtime configuration (LOCAL test stack)
# This file is gitignored. Never commit it.
#
# Generate fresh values with:
#   python -c "import secrets,base64; print(secrets.token_urlsafe(32))"
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# ============================================================

# ---- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=secure_notes
POSTGRES_PASSWORD=<pg-password>
POSTGRES_DB=secure_notes

# Connection string for the app (host names are the Compose service names).
# For host tools (drizzle-kit, Playwright) use localhost:
#   postgres://<user>:<password>@localhost:5432/<db>
DATABASE_URL=postgres://secure_notes:<pg-password>@postgres:5432/secure_notes

# ---- Valkey ----------------------------------------------------------------
VALKEY_PASSWORD=<valkey-password>
VALKEY_URL=redis://:<valkey-password>@valkey:6379

# ---- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<grafana-password>

# ---- Metrics / telemetry ---------------------------------------------------
# Bearer token required to read GET /api/metrics. Must be shared with the
# prometheus service (injected via entrypoint into metrics_token file).
METRICS_TOKEN=<metrics-token>

# ---- 2FA encryption --------------------------------------------------------
# AES-256-GCM key: base64-encoded 32 random bytes.
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TWO_FACTOR_ENCRYPTION_KEY=<base64-32-byte-key>

# ---- App -------------------------------------------------------------------
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Optional: override the base URL Playwright hits in e2e tests.
# E2E_BASE_URL=http://localhost:3000