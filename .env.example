# Secure Notes runtime configuration
# Copy to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string.
#  - On the host (Docker Compose maps postgres to localhost:5432):
#       postgres://secure_notes:secure_notes@localhost:5432/secure_notes
#  - Inside the Compose network the web container uses `postgres` as host.
DATABASE_URL=postgres://secure_notes:secure_notes@localhost:5432/secure_notes

# Valkey / Redis connection string (defaults to redis://localhost:6379).
VALKEY_URL=redis://localhost:6379

# Bearer token required to read GET /api/metrics. Must match the value
# injected into the prometheus service in docker-compose.yml.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(40))"
METRICS_TOKEN=change-me-to-a-long-random-token

# Key used to encrypt TOTP secrets before storing them (32-char alnum).
TWO_FACTOR_ENCRYPTION_KEY=replace-with-32-char-random-string

# Optional: override the base URL Playwright hits in e2e tests.
# E2E_BASE_URL=http://localhost:3000