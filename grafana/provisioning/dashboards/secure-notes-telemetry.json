  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "HTTP / API",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Total HTTP request throughput by route",
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 10, "showPoints": "never" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "title": "HTTP requests /s",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{job=\"web\"}[5m])) by (route)",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "95th percentile request latency by route",
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 10, "showPoints": "never" }, "unit": "s" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "title": "Request latency p95",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"web\"}[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "HTTP error rate (4xx/5xx) as a percentage of traffic",
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 10, "showPoints": "never" }, "unit": "percentunit" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "title": "HTTP error rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_errors_total{job=\"web\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"web\"}[5m])), 0.000001)",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Breakdown of 4xx/5xx responses by status class",
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 10, "showPoints": "never" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "title": "HTTP errors by status class",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_errors_total{job=\"web\"}[5m])) by (status_class)",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ]
    },
